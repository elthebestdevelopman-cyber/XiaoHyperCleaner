<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Разрешения -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Разрешение для SimpleRunner.forceStopPackage() -->
    <!-- Позволяет сбрасывать кэш состояния Settings после применения -->
    <!-- настроек через ADB (force-stop не удаляет данные пользователя). -->
    <!-- Защита: normal — выдаётся автоматически при установке. -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Для ADB подключения к localhost -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Для OverlayService (оверлей с роботом и подсказками) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Для запроса исключения из Battery Optimization (критично для MIUI/HyperOS) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Для предотвращения засыпания экрана во время автоматизации -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Package visibility (Android 11+) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <queries>
        <!-- Shizuku (для проверки установки) -->
        <package android:name="moe.shizuku.privileged.api" />

        <!-- Системные пакеты Xiaomi / MIUI / HyperOS для точечной оптимизации -->
        <package android:name="com.android.settings" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.securitycore" />
        <package android:name="com.miui.cleanmaster" />
        <package android:name="com.xiaomi.misettings" />

        <!-- Системные службы фонового трафика / MSA -->
        <package android:name="com.miui.msa.global" />
        <package android:name="com.miui.msa.core" />
        <package android:name="com.miui.systemAdSolution" />

        <!-- Системный браузер -->
        <package android:name="com.mi.globalbrowser" />
        <package android:name="com.android.browser" />
        <package android:name="com.miui.browser" />

        <!-- Мультимедиа и плееры -->
        <package android:name="com.miui.player" />
        <package android:name="com.miui.music" />
        <package android:name="com.mi.music" />
        <package android:name="com.miui.videoplayer" />
        <package android:name="com.miui.video" />
        <package android:name="com.mi.global.video" />

        <!-- Темы и персонализация -->
        <package android:name="com.android.thememanager" />
        <package android:name="com.miui.thememanager" />
        <package android:name="com.mi.thememanager" />

        <!-- Каталоги и маркетплейсы -->
        <package android:name="com.xiaomi.market" />
        <package android:name="com.miui.market" />
        <package android:name="com.mi.global.market" />

        <!-- Утилиты: Загрузки, Проводник, ShareMe -->
        <package android:name="com.android.providers.downloads.ui" />
        <package android:name="com.miui.android.downloads" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.mi.android.fileexplorer" />
        <package android:name="com.xiaomi.midrop" />
        <package android:name="com.mi.android.globalshareme" />

        <!-- Лаунчеры и рабочие столы (смартфоны и планшеты Pad) -->
        <package android:name="com.mi.android.globallauncher" />
        <package android:name="com.miui.home" />
        <package android:name="com.mi.android.globalHome" />
        <package android:name="com.mi.global.home" />
        <package android:name="com.miui.personalassistant" />
        <package android:name="com.mi.android.global.personalassistant" />

        <!-- Сообщения и игровые центры -->
        <package android:name="com.miui.mms" />
        <package android:name="com.android.mms" />
        <package android:name="com.miui.mms.global" />
        <package android:name="com.xiaomi.gamecenter" />
        <package android:name="com.miui.gamecenter" />
        <package android:name="com.xiaomi.glgm" />

        <!-- Магазины приложений (для установки Shizuku) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rustore" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mimarket" />
        </intent>
    </queries>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Application -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <application
        android:name=".XiaoHyperApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaoHyperCleaner"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Activities -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Главный экран -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.XiaoHyperCleaner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView для внешних ссылок (ЮMoney, GitHub) -->
        <activity
            android:name=".ui.WebViewActivity"
            android:exported="false" />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Services -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!--
            Основной Accessibility Service для выполнения шагов Simple Mode.

            ВАЖНО: android:exported="true" ОБЯЗАТЕЛЕН для Accessibility Service,
            иначе система не сможет его запустить. Защита обеспечивается через
            android:permission="BIND_ACCESSIBILITY_SERVICE".
        -->
        <service
            android:name=".service.AdbEnablerService"
            android:description="@string/accessibility_explanation_text"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- OverlayService для показа оверлеев (робот, стрелки, hints) -->
        <service
            android:name=".service.OverlayService"
            android:exported="false" />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Providers -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Shizuku Provider для Pro-режима -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="moe.shizuku.manager.permission.API_V23" />

        <!-- FileProvider для безопасного доступа к файлам (экспорт логов) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>