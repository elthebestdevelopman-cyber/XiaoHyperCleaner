<resources>
    <!-- ========== COMMON ========== -->
    <string name="app_name">XiaoHyperCleaner</string>
    <string name="app_description_short">Disable ads, telemetry and spam on Xiaomi / MIUI / HyperOS. Works via ADB and Accessibility, no root required.</string>
    <string name="cancel">Cancel</string>
    <string name="allow">Allow</string>
    <string name="agree_and_open">Agree and open</string>

    <!-- ========== MAIN SCREEN ========== -->
    <string name="features_title">What the app does</string>
    <string name="feature_processes">Disables ad and system services</string>
    <string name="feature_speed">Speeds up UI and optimizes animations</string>
    <string name="feature_battery">Improves battery life by disabling data collectors</string>

    <string name="btn_optimize">Optimize</string>
    <string name="btn_restore">Restore changes</string>
    <string name="status_working">Optimizing…</string>
    <string name="status_done">Optimization complete</string>
    <string name="status_done_description">Ads disabled, telemetry stopped, system runs faster.</string>
    <string name="reboot_now">Reboot now</string>

    <!-- ========== LEVEL SELECTION ========== -->
    <string name="simple_level_title">Choose optimization level</string>
    <string name="simple_level_simple_title">Simple</string>
    <string name="simple_level_simple_desc">The app will automatically toggle switches in phone settings (recommendations, telemetry, analytics). Grant permissions, press "Start" and just wait — everything runs automatically. If a step fails, the app will diagnose the issue and retry. No Wi‑Fi, no complicated setup.</string>
    <string name="simple_level_advanced_title">Advanced</string>
    <string name="simple_level_advanced_desc">Via Shizuku and Wireless ADB — deeper and more reliable, but requires setup.</string>
    <string name="simple_level_extreme_title">Extreme</string>
    <string name="simple_level_extreme_desc">Plus region change to DE and aggressive tweaks. May break OTA updates.</string>

    <!-- ========== SIMPLE MODE: STEPS ========== -->
