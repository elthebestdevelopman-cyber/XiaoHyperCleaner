    <!-- ========== ACCESSIBILITY POLICY DECLARATION ========== -->
    <string name="accessibility_policy_summary">Automates system settings navigation for users with limited mobility</string>
    <string name="accessibility_policy_description">The XiaoHyperCleaner accessibility service is designed for users with limited mobility and helps automatically navigate Android system settings screens at the user\'s explicit request. The service taps switches and buttons for the user, saving time and physical effort. The service DOES NOT bypass privacy controls, DOES NOT change settings without explicit consent, and DOES NOT collect user data. All actions are performed locally on the device. The service is activated only after explicit user consent and can be disabled at any time. Usage fully complies with the Accessibility Services API Policy.</string>

    <!-- ========== CONSENT DIALOG ========== -->
    <string name="consent_dialog_title">Service usage consent</string>
    <string name="consent_dialog_text">To automatically configure the app, the accessibility service will tap buttons in system settings on your behalf. The service:\n\n• Does NOT bypass privacy controls\n• Does NOT change settings without your consent\n• Does NOT send data externally\n• Can be disabled at any time</string>
    <string name="consent_checkbox_label">I understand and consent to use the accessibility service to automate settings navigation</string>
    <string name="consent_confirm_button">Agree and continue</string>
    <string name="consent_cancel_button">Cancel</string>

