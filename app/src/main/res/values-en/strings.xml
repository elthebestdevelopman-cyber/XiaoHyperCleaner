    <string name="shizuku_dialog_title">Advanced mode requires Shizuku</string>
    <string name="shizuku_dialog_not_installed">Shizuku is not installed. Install it from the app store.</string>
    <string name="shizuku_dialog_not_running">Shizuku is installed but not running. Open the app and follow steps 1–5.</string>
    <string name="shizuku_dialog_permission">Shizuku is running, but our app needs permission.</string>
    <string name="shizuku_dialog_install">Install</string>
    <string name="shizuku_dialog_howto">How to start</string>
    <string name="shizuku_dialog_later">Later</string>
    <string name="shizuku_card_other_sources">Other install sources</string>

