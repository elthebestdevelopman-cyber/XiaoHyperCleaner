    <string name="optimization_failed_retry">Try again</string>
    <string name="optimization_failed_manual">Manual instructions</string>

    <!-- Manual instructions -->
    <string name="manual_instructions_title">Manual setup</string>
    <string name="manual_instructions_text">If automatic optimization didn\'t work, you can perform it manually through developer settings:\n\n1. Open Settings → About phone\n2. Tap MIUI / OS version 7 times\n3. Go back to Settings → Additional settings → Developer options\n4. Enable Wireless debugging\n5. Connect the device to a computer via USB and run ADB commands from the README on GitHub</string>

