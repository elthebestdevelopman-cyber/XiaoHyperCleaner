    <!-- ========== LEVEL SELECTION ========== -->
    <string name="simple_level_title">Choose optimization level</string>
    <string name="simple_level_simple_title">Simple</string>
    <string name="simple_level_simple_desc">The app will automatically toggle switches in phone settings (recommendations, telemetry, analytics). Grant permissions, press "Start" and just wait — everything runs automatically. If a step fails, the app will diagnose the issue and retry. No Wi‑Fi, no complicated setup.</string>
    <string name="simple_level_advanced_title">Advanced</string>
    <string name="simple_level_advanced_desc">Via Shizuku and Wireless ADB — deeper and more reliable, but requires setup.</string>
    <string name="simple_level_extreme_title">Extreme</string>
    <string name="simple_level_extreme_desc">Maximum cleanup with advanced system service tweaks. May affect some Xiaomi features.</string>

