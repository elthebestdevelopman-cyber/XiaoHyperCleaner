    <string name="shizuku_wizard_step6">Shizuku is running. Now press "Request permission" below.</string>
    <string name="shizuku_wizard_permission_denied">Shizuku permission denied. Open Shizuku and grant it manually.</string>

    <!-- ========== OPTIONS (DNS, AGGRESSIVE) ========== -->
    <string name="options_dialog_title">Optimization options</string>
    <string name="options_dialog_text">Choose additional options. You can change them later.</string>
    <string name="dns_option_title">DNS filter</string>
    <string name="dns_option_description">Block ads and trackers at the network level via AdGuard DNS.</string>
    <string name="aggressive_option_title">Aggressive mode</string>
    <string name="aggressive_option_description">⚠ Changes region to DE. May break OTA updates and some Xiaomi services.</string>
    <string name="options_dialog_start">Start optimization</string>

    <!-- ========== DNS WARNING ========== -->
    <string name="dns_warning_title">Attention: DNS filter</string>
    <string name="dns_warning_text">AdGuard Private DNS will be set. This blocks ads in browsers and apps, but may block some sites. You can disable it anytime in Android settings.</string>
    <string name="dns_warning_accept">Understood, continue</string>

    <!-- ========== DEV MODE ========== -->
    <string name="dev_mode_dialog_title">Developer mode required</string>
    <string name="dev_mode_dialog_text">To continue, enable Developer mode. Open "About phone" and tap "MIUI version" 7 times.</string>
    <string name="dev_mode_dialog_open_about">Open "About phone"</string>
    <string name="dev_mode_dialog_retry">Try again</string>

    <!-- ========== ACCESSIBILITY ========== -->
    <string name="accessibility_explanation_title">Accessibility service required</string>
    <string name="accessibility_explanation_text">The app needs Accessibility access to automatically click buttons in settings. Access is used only for optimization and is never sent anywhere.</string>
    <string name="hint_accessibility">Enable "XiaoHyperCleaner" in the services list</string>

    <!-- ========== OVERLAY ========== -->
    <string name="overlay_permission_title">"Display over other apps" permission</string>
    <string name="overlay_permission_text">Needed to show hints while setting up other apps.</string>
    <string name="hint_overlay">Allow display over other apps</string>

    <!-- ========== RESTRICTED / FORBIDDEN (Android 13+ sideload) ========== -->
    <string name="restricted_dialog_title">Restricted settings</string>
    <string name="restricted_dialog_text">To enable the Accessibility service, you must first allow "Restricted settings" in the app info screen.</string>
    <string name="restricted_dialog_open">Open app settings</string>
    <string name="hint_restricted">Tap 3 dots at the top → "Allow restricted settings"</string>

    <string name="forbidden_dialog_title">Forbidden settings</string>
    <string name="hint_title">Hint</string>
    <string name="forbidden_dialog_text">On Android 14+ you must allow "Forbidden settings" in the app info screen.</string>
    <string name="forbidden_dialog_open">Open app settings</string>

    <!-- ========== RESTORE / REBOOT ========== -->
    <string name="restore_dialog_title">Restore changes?</string>
    <string name="restore_dialog_text">All settings will return to their original state, disabled apps will be re-enabled.</string>
    <string name="restore_confirm">Restore</string>
    <string name="restore_failed_text">Could not fully restore changes. Some settings remain modified.</string>

    <string name="reboot_dialog_title">Reboot</string>
    <string name="reboot_dialog_text">Reboot the device for all optimizations to take effect.</string>
    <string name="reboot_confirm">Reboot</string>
    <string name="reboot_failed_text">Could not send reboot command. Please reboot manually.</string>

