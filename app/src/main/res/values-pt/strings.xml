    <!-- ========== ACCESSIBILITY POLICY ========== -->
    <string name="accessibility_policy_summary">Automação de navegação em configurações para usuários com mobilidade reduzida</string>
    <string name="accessibility_policy_description">O serviço de acessibilidade do XiaoHyperCleaner destina-se a usuários com mobilidade reduzida e ajuda a navegar automaticamente pelas telas de configurações do Android mediante solicitação explícita. O serviço toca em interruptores pelo usuário. Nenhum dado pessoal é coletado ou transmitido.</string>

    <!-- ========== CONSENT DIALOG ========== -->
    <string name="consent_dialog_title">Serviço de acessibilidade</string>
    <string name="consent_dialog_text">O serviço é necessário para configurar automaticamente as opções de privacidade sem navegação manual nos menus.\n\nO que fazer na próxima tela:\n1. Na lista aberta, localize "XiaoHyperCleaner" (na seção "Apps transferidos por download" ou "Serviços transferidos").\n2. Ative o interruptor do serviço de acessibilidade.\n3. Confirme a ativação e retorne ao aplicativo.\n\nO serviço não transmite dados para fora, não contorna controles de privacidade e pode ser desativado a qualquer momento.</string>
    <string name="consent_checkbox_label">Eu compreendo e autorizo o uso do serviço de acessibilidade para automatizar as configurações</string>
    <string name="consent_confirm_button">Concordar e continuar</string>
    <string name="consent_cancel_button">Cancelar</string>

