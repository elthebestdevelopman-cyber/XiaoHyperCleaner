    <!-- ========== ACCESSIBILITY ========== -->
    <string name="accessibility_explanation_text">O serviço de acessibilidade ajuda usuários com mobilidade reduzida a navegar automaticamente pelas telas de configurações do sistema: ele toca nos interruptores necessários pelo usuário. Nenhum dado é coletado ou transmitido para servidores.</string>
    <string name="hint_accessibility">Ative "XiaoHyperCleaner" na lista de serviços</string>
    <string name="hint_overlay">Permitir exibição sobre outros aplicativos</string>

    <!-- ========== OVERLAY ========== -->
    <string name="overlay_permission_title">Permissão "Exibir sobre outros apps"</string>
    <string name="overlay_permission_text">Permissão necessária para exibir a tela de automação e o status do progresso.\n\n1. Na lista aberta, localize "XiaoHyperCleaner".\n2. Ative o interruptor "Permitir sobreposição a outros apps".\n3. Toque em Voltar para retornar ao aplicativo.</string>

    <!-- ========== RESTRICTED / FORBIDDEN ========== -->
    <string name="restricted_dialog_title">Configurações restritas</string>
    <string name="restricted_dialog_text">Para habilitar o serviço de acessibilidade, é necessária permissão única nas configurações do app:\n\n1. Nas configurações do app abertas, toque no menu ⋮ no canto superior direito (ou role para baixo).\n2. Selecione "Permitir configurações restritas".\n3. Confirme com digital ou senha e retorne ao app.</string>
    <string name="restricted_dialog_open">Abrir configurações do app</string>

    <string name="forbidden_dialog_title">Configurações proibidas</string>
    <string name="forbidden_dialog_text">Para habilitar o serviço de acessibilidade, é necessária permissão única nas configurações do app:\n\n1. Nas configurações do app abertas, toque no menu ⋮ no canto superior direito (ou role para baixo).\n2. Selecione "Permitir configurações proibidas".\n3. Confirme com digital ou senha e retorne ao app.</string>
    <string name="forbidden_dialog_open">Abrir configurações do app</string>

