<?xml version="1.0" encoding="utf-8"?><!--
    Цветовые ресурсы для ТЁМНОЙ темы.
    Применяется когда в системе включена тёмная тема.

    ИСПОЛЬЗУЮТСЯ В:
    - values-night/themes.xml (android:windowBackground, windowSplashScreenBackground)
    - Системные элементы до загрузки Compose

    СИНХРОНИЗАЦИЯ С Compose (Color.kt):
    - splash_background_night (#FF121212) == DarkBackground из Color.kt
      Это обеспечивает ПЛАВНЫЙ переход от сплэша к приложению
      без визуального "прыжка" цвета.

    ФОРМАТ:
    - AARRGGBB (с альфа-каналом)
    - FF = полностью непрозрачный

    ВАЖНО:
    Для светлой темы см. values/colors.xml
-->
<resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Сплэш и фон окна до загрузки Compose (тёмная тема) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!--
        Цвет фона сплэша и окна до загрузки Compose (тёмная тема).

        Синхронизирован с DarkBackground из Color.kt (#FF121212)
        для плавного перехода от сплэша к приложению.

        Отображается:
        1. При запуске приложения (сплэш в тёмном режиме)
        2. В момент между закрытием сплэша и первой отрисовкой Compose
        3. В статус-баре и навигации (если не прозрачные)

        Используется в:
        - Theme.XiaoHyperCleaner (night) → android:windowBackground
        - Theme.XiaoHyperCleaner.Splash (night) → windowSplashScreenBackground
    -->
    <color name="splash_background">#FF121212</color>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Дополнительные цвета (для будущих нужд и виджетов) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!--
        Цвет уведомления в тёмной теме.
        Чуть светлее, чем в светлой теме для контрастности на тёмном фоне.
    -->
    <color name="notification_accent">#FF1976D2</color>

    <!--
        Цвет для ярлыков (shortcuts) и виджетов в тёмной теме.
        Синхронизирован с Blue500 из Color.kt (#FF2196F3).
    -->
    <color name="widget_accent">#FF2196F3</color>

    <!--
        Цвет иконки приложения для адаптивных иконок в тёмной теме.
        Синхронизирован с фоном сплэша.
    -->
    <color name="ic_launcher_background">#FF121212</color>
</resources>