<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">XiaoHyperCleaner</string>
    <string name="splash_tagline">Без root. Без лишнего. Без данных.</string>

    <!-- Основные кнопки -->
    <string name="btn_optimize">Оптимизировать</string>
    <string name="btn_restore">Отменить оптимизацию</string>
    <string name="reboot_now">Перезагрузить</string>

    <!-- Меню -->
    <string name="menu_about">О программе</string>
    <string name="menu_dark_theme">Тёмная тема</string>
    <string name="close">Закрыть</string>
    <string name="cancel">Отмена</string>
    <string name="allow">Продолжить</string>

    <!-- О программе -->
    <string name="about_title">О программе</string>
    <string name="about_version">Версия 1.0</string>
    <string name="about_author">Автор: ElthebestDevelopman</string>
    <string name="about_text">Инструмент для настройки устройств Xiaomi, Redmi и Poco. Отключает системные сервисы аналитики и применяет параметры MIUI / HyperOS через локальный ADB. Все изменения обратимы. Результат зависит от модели и версии прошивки.</string>

    <!-- Поддержка -->
    <string name="support_title">Поддержите разработку:</string>
    <string name="support_yoomoney">Поддержать (ЮMoney)</string>
    <string name="support_cloudtips">Поддержать (CloudTips)</string>
    <string name="rate_app">Оценить приложение</string>
    <string name="log_share">Поделиться логом</string>

    <!-- Описание приложения -->
    <string name="app_description_short">Безопасная настройка для Xiaomi, Redmi, Poco. Отключает ненужные фоновые процессы и системную аналитику.</string>
    <string name="features_title">Что делает приложение</string>
    <string name="feature_processes">Отключает системные сервисы аналитики</string>
    <string name="feature_speed">Настраивает системные параметры MIUI / HyperOS</string>
    <string name="feature_battery">Работает без root-прав</string>

    <!-- Диалог службы спец возможностей -->
    <string name="accessibility_explanation_title">Служба специальных возможностей</string>
    <string name="accessibility_explanation_text">Для автоматической настройки приложению нужна служба специальных возможностей. Она один раз включит беспроводную отладку и выполнит настройку. Данные не собираются.</string>
    <string name="agree_and_open">Включить</string>

    <!-- Диалог оверлея -->
    <string name="overlay_permission_title">Показ поверх других окон</string>
    <string name="overlay_permission_text">Разрешение нужно, чтобы показывать прогресс выполнения. Переключатель включится автоматически — просто подтвердите действие.</string>

    <!-- Restricted/Forbidden settings dialog для Android 13 -->
    <string name="restricted_dialog_title">Ограниченные настройки</string>
    <string name="restricted_dialog_text">Для работы приложения необходимо разрешить ограниченные настройки. Откройте карточку приложения в настройках устройства, нажмите ⋮ в правом верхнем углу и выберите «Разрешить ограниченные настройки».</string>
    <string name="restricted_dialog_open">Открыть настройки</string>

    <!-- Restricted/Forbidden settings dialog для Android 14+ -->
    <string name="forbidden_dialog_title">Запрещённые настройки</string>
    <string name="forbidden_dialog_text">Для работы приложения необходимо разрешить запрещённые настройки. Следуйте инструкции:\n\n1. Нажмите кнопку ниже, чтобы открыть настройки приложения\n2. В правом верхнем углу нажмите ⋮ (три точки)\n3. Выберите «Разрешить запрещённые настройки»\n4. Вернитесь в приложение</string>
    <string name="forbidden_dialog_open">Открыть настройки приложения</string>

    <!-- Статусы -->
    <string name="status_working">Выполняется…</string>
    <string name="status_done">Оптимизация завершена!</string>
    <string name="status_done_description">Ненужные фоновые процессы отключены.</string>

    <!-- Диалог восстановления -->
    <string name="restore_dialog_title">Отменить оптимизацию</string>
    <string name="restore_dialog_text">Все параметры и сервисы вернутся к исходному состоянию, устройство снова будет работать как раньше. Восстановить?</string>
    <string name="restore_confirm">Да, восстановить</string>
    <string name="restore_failed_text">Не удалось откатить изменения. Убедитесь, что включена беспроводная отладка, и попробуйте ещё раз.</string>

    <!-- Диалог перезагрузки -->
    <string name="reboot_dialog_title">Перезагрузка устройства</string>
    <string name="reboot_dialog_text">Устройство будет перезагружено через ADB. Несохранённые данные могут быть потеряны. Продолжить?</string>
    <string name="reboot_confirm">Перезагрузить</string>
    <string name="reboot_failed_text">Не удалось отправить команду перезагрузки через ADB.</string>

    <!-- Финальный диалог -->
    <string name="final_dialog_title">Настройка завершена</string>
    <string name="final_dialog_success_text">Все параметры применены успешно. Реклама в системных приложениях отключена, рекомендации больше не отображаются. Если всё понравилось, оставьте отзыв — это поможет другим пользователям найти приложение.</string>
    <string name="final_dialog_failed_text">Не удалось применить все изменения. Пожалуйста, отправьте лог разработчику для выявления ошибок.</string>
    <string name="final_dialog_rate">Оценить приложение</string>
    <string name="final_dialog_send_log">Отправить лог</string>

    <!-- Тексты для accessibility-цепочки -->
    <string name="allow_button_ru">Разрешить</string>
    <string name="allow_button_en">Allow</string>
    <string-array name="wireless_debugging_texts">
        <item>Беспроводная отладка</item>
        <item>Wireless debugging</item>
    </string-array>

