<resources>
    <!-- ========== ОБЩИЕ ========== -->
    <string name="app_name">XiaoHyperCleaner</string>
    <string name="app_description_short">Отключаем рекламу, телеметрию и спам на Xiaomi / MIUI / HyperOS. Работает через ADB и Accessibility, без root.</string>
    <string name="cancel">Отмена</string>
    <string name="allow">Разрешить</string>
    <string name="agree_and_open">Согласиться и открыть</string>

    <!-- ========== ГЛАВНЫЙ ЭКРАН ========== -->
    <string name="features_title">Что делает приложение</string>
    <string name="feature_processes">Отключение рекламных и системных сервисов</string>
    <string name="feature_speed">Ускорение интерфейса и оптимизация анимаций</string>
    <string name="feature_battery">Улучшение автономности за счёт отключения сборщиков данных</string>

    <string name="btn_optimize">Оптимизировать</string>
    <string name="btn_restore">Откатить изменения</string>
    <string name="status_working">Выполняется оптимизация…</string>
    <string name="status_done">Оптимизация завершена</string>
    <string name="status_done_description">Реклама отключена, телеметрия остановлена, система работает быстрее.</string>
    <string name="reboot_now">Перезагрузить сейчас</string>

    <!-- ========== ВЫБОР УРОВНЯ ========== -->
    <string name="level_dialog_title">Выберите уровень оптимизации</string>
    <string name="level_dialog_text">Простой режим подойдёт всем — приложение само выполнит настройки. Продвинутый требует Shizuku/ADB, но даёт больше контроля.</string>
    <string name="level_simple_title">🟢 Простая</string>
    <string name="level_simple_desc">Для всех пользователей. Приложение само настроит систему — просто выдайте разрешения и подождите.</string>
    <string name="level_advanced_title">🔵 Продвинутая</string>
    <string name="level_advanced_desc">Для опытных. Глубокая настройка через Shizuku или Wireless ADB. Надёжнее, но требует подготовки.</string>
    <string name="level_extreme_title">🔴 Экстремальная</string>
    <string name="level_extreme_desc">Максимальная очистка с расширенными настройками системных сервисов. Может повлиять на работу некоторых функций Xiaomi. Только для опытных пользователей.</string>
    
    <string name="level_confirm_simple_title">Запустить простую оптимизацию?</string>
    <string name="level_confirm_simple_text">Приложение откроет настройки и автоматически отключит рекламу, телеметрию и спам. Это займёт 2–3 минуты.</string>
    <string name="level_confirm_advanced_title">Запустить продвинутую оптимизацию?</string>
    <string name="level_confirm_advanced_text">Потребуется настроить Shizuku или Wireless ADB. Процесс глубже и надёжнее, но занимает больше времени.</string>
    <string name="level_confirm_extreme_title">Запустить экстремальную оптимизацию?</string>
    <string name="level_confirm_extreme_text">Внимание: расширенные настройки системных сервисов могут повлиять на работу некоторых функций Xiaomi. Продолжайте только если понимаете риски.</string>
    <string name="level_confirm_start">Начать</string>

