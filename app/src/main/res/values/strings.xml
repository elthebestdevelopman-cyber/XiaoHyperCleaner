<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== ОБЩИЕ ========== -->
    <string name="app_name">XiaoHyperCleaner</string>
    <string name="app_description_short">Отключаем рекламу, телеметрию и спам на Xiaomi / MIUI / HyperOS. Работает через ADB и Accessibility, без root.</string>
    <string name="cancel">Отмена</string>
    <string name="allow">Разрешить</string>
    <string name="agree_and_open">Согласиться и открыть</string>

    <!-- ========== ГЛАВНЫЙ ЭКРАН ========== -->
    <string name="features_title">Что делает приложение</string>
    <string name="feature_processes">Отключение рекламных и системных сервисов</string>
    <string name="feature_speed">Ускорение интерфейса и оптимизация анимаций</string>
    <string name="feature_battery">Улучшение автономности за счёт отключения сборщиков данных</string>

    <string name="btn_optimize">Оптимизировать</string>
    <string name="btn_restore">Откатить изменения</string>
    <string name="status_working">Выполняется оптимизация…</string>
    <string name="status_done">Оптимизация завершена</string>
    <string name="status_done_description">Реклама отключена, телеметрия остановлена, система работает быстрее.</string>
    <string name="reboot_now">Перезагрузить сейчас</string>

    <!-- ========== ВЫБОР УРОВНЯ ========== -->
    <string name="simple_level_title">Выберите уровень оптимизации</string>
    <string name="simple_level_simple_title">Простая</string>
    <string name="simple_level_simple_desc">Приложение само выключит переключатели в настройках телефона (рекомендации, телеметрия, аналитика). Выдайте разрешения, нажмите «Начать» и просто подождите — всё выполнится автоматически. Если шаг не получится, приложение проверит причину и повторит попытку. Без Wi‑Fi и сложных настроек.</string>
    <string name="simple_level_advanced_title">Продвинутая</string>
    <string name="simple_level_advanced_desc">Через Shizuku и Wireless ADB — глубже и надёжнее, но требует настройки.</string>
    <string name="simple_level_extreme_title">Экстремальная</string>
    <string name="simple_level_extreme_desc">Плюс смена региона на DE и агрессивные настройки. Может сломать OTA-обновления.</string>

    <!-- ========== ПРОСТОЙ РЕЖИМ: ШАГИ ========== -->
    <string name="simple_step_of">Шаг %1$d из %2$d</string>
    <string name="simple_step_start">Начать</string>
    <string name="simple_step_working">Выполняется…</string>
    <string name="simple_step_attempt">Попытка %1$d из %2$d</string>
    <string name="simple_step_success">Готово</string>
    <string name="simple_step_auto_next">Готово — переходим дальше…</string>
    <string name="simple_step_failed">Не получилось сделать автоматически</string>
    <string name="simple_step_next">Далее</string>
    <string name="simple_step_skip">Пропустить шаг</string>
    <string name="simple_step_retry">Повторить попытку</string>

    <!-- ========== ПРОСТОЙ РЕЖИМ: ФИНАЛ ========== -->
    <string name="simple_done_title">Всё готово!</string>
    <string name="simple_done_text">Реклама, телеметрия и спам отключены. Перезагрузка не требуется.</string>
    <string name="simple_done_steps_done">Выполнено %1$d из %2$d шагов</string>
    <string name="simple_done_rate">Оценить приложение</string>
    <string name="simple_done_donate">Поддержать автора</string>
    <string name="simple_done_close">Закрыть</string>

    <!-- ========== SHIZUKU ДИАЛОГИ ========== -->
    <string name="shizuku_dialog_title">Для продвинутого режима нужен Shizuku</string>
    <string name="shizuku_dialog_not_installed">Shizuku не установлен. Установите его из магазина приложений.</string>
    <string name="shizuku_dialog_not_running">Shizuku установлен, но не запущен. Откройте приложение и выполните шаги 1–5.</string>
    <string name="shizuku_dialog_permission">Shizuku работает, но нужно дать разрешение нашему приложению.</string>
    <string name="shizuku_dialog_install">Установить</string>
    <string name="shizuku_dialog_howto">Как запустить</string>
    <string name="shizuku_dialog_later">Позже</string>
    <string name="shizuku_card_other_sources">Другие источники установки</string>

    <string name="shizuku_wizard_not_ready">Shizuku ещё не готов. Повторите шаги 1–5 в приложении Shizuku и нажмите «Проверить» снова.</string>
    <string name="shizuku_wizard_step6">Shizuku запущен. Теперь нажмите «Запросить разрешение» ниже.</string>
    <string name="shizuku_wizard_permission_denied">Разрешение Shizuku отклонено. Откройте Shizuku и разрешите вручную.</string>

    <!-- ========== ОПЦИИ (DNS, AGGRESSIVE) ========== -->
    <string name="options_dialog_title">Параметры оптимизации</string>
    <string name="options_dialog_text">Выберите дополнительные опции. Их можно изменить позже.</string>
    <string name="dns_option_title">DNS-фильтр</string>
    <string name="dns_option_description">Блокировка рекламы и трекеров на сетевом уровне через AdGuard DNS.</string>
    <string name="aggressive_option_title">Агрессивный режим</string>
    <string name="aggressive_option_description">⚠ Смена региона на DE. Может сломать OTA-обновления и некоторые сервисы Xiaomi.</string>
    <string name="options_dialog_start">Начать оптимизацию</string>

    <!-- ========== DNS ПРЕДУПРЕЖДЕНИЕ ========== -->
    <string name="dns_warning_title">Внимание: DNS-фильтр</string>
    <string name="dns_warning_text">Будет установлен приватный DNS AdGuard. Это отключит рекламу в браузере и приложениях, но может заблокировать некоторые сайты. Отключить можно в любой момент в настройках Android.</string>
    <string name="dns_warning_accept">Понятно, продолжить</string>

    <!-- ========== DEV MODE ========== -->
    <string name="dev_mode_dialog_title">Нужен режим разработчика</string>
    <string name="dev_mode_dialog_text">Для продолжения нужно включить режим разработчика. Откройте «О телефоне» и 7 раз нажмите «Версия MIUI».</string>
    <string name="dev_mode_dialog_open_about">Открыть «О телефоне»</string>
    <string name="dev_mode_dialog_retry">Попробовать снова</string>

    <!-- ========== ACCESSIBILITY ========== -->
    <string name="accessibility_explanation_title">Нужны специальные возможности</string>
    <string name="accessibility_explanation_text">Приложению нужен доступ к специальным возможностям, чтобы автоматически нажимать кнопки в настройках. Доступ используется только для оптимизации и не передаётся наружу.</string>
    <string name="hint_accessibility">Включите «XiaoHyperCleaner» в списке служб</string>

    <!-- ========== OVERLAY ========== -->
    <string name="overlay_permission_title">Разрешение «Поверх других окон»</string>
    <string name="overlay_permission_text">Нужно, чтобы показывать подсказки во время настройки в других приложениях.</string>
    <string name="hint_overlay">Разрешите отображение поверх других окон</string>

    <!-- ========== RESTRICTED / FORBIDDEN (Android 13+ sideload) ========== -->
    <string name="restricted_dialog_title">Ограниченные настройки</string>
    <string name="restricted_dialog_text">Для включения службы специальных возможностей нужно сначала разрешить «Ограниченные настройки» в карточке приложения.</string>
    <string name="restricted_dialog_open">Открыть настройки приложения</string>
    <string name="hint_restricted">Нажмите 3 точки сверху → «Разрешить ограниченные настройки»</string>

    <string name="forbidden_dialog_title">Запрещённые настройки</string>
    <string name="forbidden_dialog_text">На Android 14+ нужно разрешить «Запрещённые настройки» в карточке приложения.</string>
    <string name="forbidden_dialog_open">Открыть настройки приложения</string>

    <!-- ========== ВОССТАНОВЛЕНИЕ / ПЕРЕЗАГРУЗКА ========== -->
    <string name="restore_dialog_title">Откатить изменения?</string>
    <string name="restore_dialog_text">Все настройки вернутся в исходное состояние, отключённые приложения будут включены.</string>
    <string name="restore_confirm">Откатить</string>
    <string name="restore_failed_text">Не удалось полностью откатить изменения. Часть настроек осталась изменённой.</string>

    <string name="reboot_dialog_title">Перезагрузка</string>
    <string name="reboot_dialog_text">Перезагрузите устройство, чтобы все оптимизации вступили в силу.</string>
    <string name="reboot_confirm">Перезагрузить</string>
    <string name="reboot_failed_text">Не удалось отправить команду перезагрузки. Перезагрузите устройство вручную.</string>

    <!-- ========== ФИНАЛЬНЫЙ ДИАЛОГ (продвинутый режим) ========== -->
    <string name="final_dialog_title">Результат оптимизации</string>
    <string name="final_dialog_success_text">Оптимизация успешно завершена. Все рекламные и телеметрические сервисы отключены.</string>
    <string name="final_dialog_failed_text">Оптимизация завершилась с ошибками. Пожалуйста, отправьте лог разработчику.</string>
    <string name="final_dialog_rate">Оценить приложение</string>
    <string name="final_dialog_send_log">Отправить лог</string>
</resources>