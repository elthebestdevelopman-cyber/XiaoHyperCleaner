    <!-- ========== ОПЦИИ (DNS, AGGRESSIVE) ========== -->
    <string name="options_dialog_title">Параметры оптимизации</string>
    <string name="options_dialog_text">Выберите дополнительные опции. Их можно изменить позже.</string>
    <string name="dns_option_title">DNS-фильтр</string>
    <string name="dns_option_description">Блокировка рекламы и трекеров на сетевом уровне через AdGuard DNS.</string>
    <string name="aggressive_option_title">Расширенная оптимизация</string>
    <string name="aggressive_option_description">⚠ Дополнительные настройки системных сервисов. Может повлиять на работу некоторых функций Xiaomi.</string>
    <string name="options_dialog_start">Начать оптимизацию</string>

    <!-- ========== DNS ПРЕДУПРЕЖДЕНИЕ ========== -->
    <string name="dns_warning_title">Внимание: DNS-фильтр</string>
    <string name="dns_warning_text">Будет установлен приватный DNS AdGuard. Это отключит рекламу в браузере и приложениях, но может заблокировать некоторые сайты. Отключить можно в любой момент в настройках Android.</string>
    <string name="dns_warning_accept">Понятно, продолжить</string>

    <!-- ========== DEV MODE ========== -->
    <string name="dev_mode_dialog_title">Нужен режим разработчика</string>
    <string name="dev_mode_dialog_text">Для продолжения нужно включить режим разработчика. Откройте «О телефоне» и 7 раз нажмите «Версия MIUI».</string>
    <string name="dev_mode_dialog_open_about">Открыть «О телефоне»</string>
    <string name="dev_mode_dialog_retry">Попробовать снова</string>

    <!-- ========== ACCESSIBILITY ========== -->
    <string name="accessibility_explanation_title">Нужны специальные возможности</string>
    <string name="accessibility_explanation_text">Приложению нужен доступ к специальным возможностям для помощи пользователям с ограниченными возможностями автоматически нажимать кнопки в настройках. Доступ используется только для оптимизации и не передаётся наружу.</string>
    <string name="hint_title">Подсказка</string>
    <string name="hint_accessibility">Включите «XiaoHyperCleaner» в списке служб</string>

    <!-- ========== OVERLAY ========== -->
    <string name="overlay_permission_title">Разрешение «Поверх других окон»</string>
    <string name="overlay_permission_text">Нужно, чтобы показывать подсказки во время настройки в других приложениях.</string>
    <string name="hint_overlay">Разрешите отображение поверх других окон</string>

    <!-- ========== RESTRICTED / FORBIDDEN (Android 13+ sideload) ========== -->
    <string name="restricted_dialog_title">Ограниченные настройки</string>
    <string name="restricted_dialog_text">Для включения службы специальных возможностей нужно сначала разрешить «Ограниченные настройки» в карточке приложения.</string>
    <string name="restricted_dialog_open">Открыть настройки приложения</string>
    <string name="hint_restricted">Нажмите 3 точки сверху → «Разрешить ограниченные настройки»</string>

    <string name="forbidden_dialog_title">Запрещённые настройки</string>
    <string name="forbidden_dialog_text">На Android 14+ нужно разрешить «Запрещённые настройки» в карточке приложения.</string>
    <string name="forbidden_dialog_open">Открыть настройки приложения</string>

    <!-- ========== ВОССТАНОВЛЕНИЕ / ПЕРЕЗАГРУЗКА ========== -->
    <string name="restore_dialog_title">Откатить изменения?</string>
    <string name="restore_dialog_text">Все настройки вернутся в исходное состояние, отключённые приложения будут включены.</string>
    <string name="restore_confirm">Откатить</string>
    <string name="restore_failed_text">Не удалось полностью откатить изменения. Часть настроек осталась изменённой.</string>

    <string name="reboot_dialog_title">Перезагрузка</string>
    <string name="reboot_dialog_text">Перезагрузите устройство, чтобы все оптимизации вступили в силу.</string>
    <string name="reboot_confirm">Перезагрузить</string>
    <string name="reboot_failed_text">Не удалось отправить команду перезагрузки. Перезагрузите устройство вручную.</string>

