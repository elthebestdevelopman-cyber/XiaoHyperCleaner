<?xml version="1.0" encoding="utf-8"?><!--
    Цветовые ресурсы для СВЕТЛОЙ темы.

    ИСПОЛЬЗУЮТСЯ В:
    - themes.xml (android:windowBackground, windowSplashScreenBackground)
    - Системные элементы до загрузки Compose

    СИНХРОНИЗАЦИЯ С Compose (Color.kt):
    - splash_background (#FF1976D2) ≈ Blue700 Material Design
      (брендовый цвет приложения, согласован с Blue500 = #FF2196F3)

    ФОРМАТ:
    - AARRGGBB (с альфа-каналом)
    - FF = полностью непрозрачный

    ВАЖНО:
    Для тёмной темы см. values-night/colors.xml
-->
<resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Сплэш и фон окна до загрузки Compose -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!--
        Цвет фона сплэша и окна до загрузки Compose (светлая тема).

        Брендовый синий (Blue700 Material Design).
        Отображается:
        1. При запуске приложения (сплэш)
        2. В момент между закрытием сплэша и первой отрисовкой Compose
        3. В статус-баре и навигации (если не прозрачные)

        Используется в:
        - Theme.XiaoHyperCleaner → android:windowBackground
        - Theme.XiaoHyperCleaner.Splash → windowSplashScreenBackground
    -->
    <color name="splash_background">#FF1976D2</color>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Дополнительные цвета (для будущих нужд и виджетов) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!--
        Цвет уведомления (если будет добавлена NotificationCompat).
        Должен быть темнее основного для читаемости иконок.
    -->
    <color name="notification_accent">#FF1565C0</color>

    <!--
        Цвет для ярлыков (shortcuts) и виджетов.
        Синхронизирован с Blue500 из Color.kt (#FF2196F3).
    -->
    <color name="widget_accent">#FF2196F3</color>

    <!--
        Цвет иконки приложения для адаптивных иконок (если понадобится).
        Обычно совпадает с фоном сплэша.
    -->
    <color name="ic_launcher_background">#FF1976D2</color>
</resources>