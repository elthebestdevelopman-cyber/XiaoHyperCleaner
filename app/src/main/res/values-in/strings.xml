    <!-- ========== ACCESSIBILITY POLICY ========== -->
    <string name="accessibility_policy_summary">Otomatisasi navigasi setelan untuk pengguna dengan keterbatasan mobilitas</string>
    <string name="accessibility_policy_description">Layanan aksesibilitas XiaoHyperCleaner dirancang untuk pengguna dengan keterbatasan mobilitas dan membantu menavigasi layar setelan sistem Android secara otomatis atas permintaan pengguna. Layanan mengetuk sakelar atas nama pengguna. Tidak ada data pribadi yang dikumpulkan atau dikirim.</string>

    <!-- ========== CONSENT DIALOG ========== -->
    <string name="consent_dialog_title">Layanan aksesibilitas</string>
    <string name="consent_dialog_text">Layanan ini diperlukan untuk mengonfigurasi setelan privasi secara otomatis tanpa pencarian manual di menu.\n\nLangkah di layar berikutnya:\n1. Pada daftar yang terbuka, temukan "XiaoHyperCleaner" (di bagian "Aplikasi terunduh" atau "Layanan terunduh").\n2. Aktifkan sakelar layanan aksesibilitas.\n3. Konfirmasi pengaktifan dan kembali ke aplikasi.\n\nLayanan ini tidak mengirimkan data keluar, tidak melewati kontrol privasi, dan dapat dinonaktifkan kapan saja.</string>
    <string name="consent_checkbox_label">Saya mengerti dan menyetujui penggunaan layanan aksesibilitas untuk mengotomatiskan setelan</string>
    <string name="consent_confirm_button">Setuju dan lanjutkan</string>
    <string name="consent_cancel_button">Batal</string>

