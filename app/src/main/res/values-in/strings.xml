    <!-- ========== ACCESSIBILITY ========== -->
    <string name="accessibility_explanation_text">Layanan aksesibilitas membantu pengguna dengan keterbatasan mobilitas untuk menavigasi layar setelan sistem secara otomatis: layanan ini mengetuk sakelar yang diperlukan atas nama pengguna. Tidak ada data yang dikumpulkan atau dikirim ke server.</string>
    <string name="hint_accessibility">Aktifkan "XiaoHyperCleaner" di daftar layanan</string>
    <string name="hint_overlay">Izinkan tampilan di atas aplikasi lain</string>

    <!-- ========== OVERLAY ========== -->
    <string name="overlay_permission_title">Izin "Tampilkan di atas aplikasi lain"</string>
    <string name="overlay_permission_text">Izin diperlukan untuk menampilkan layar otomatisasi dan status progres.\n\n1. Di daftar yang terbuka, temukan "XiaoHyperCleaner".\n2. Aktifkan sakelar "Tampilkan di atas aplikasi lain".\n3. Ketuk Kembali untuk kembali ke aplikasi.</string>

    <!-- ========== RESTRICTED / FORBIDDEN ========== -->
    <string name="restricted_dialog_title">Setelan yang dibatasi</string>
    <string name="restricted_dialog_text">Untuk mengaktifkan layanan aksesibilitas, diperlukan izin sekali di setelan aplikasi:\n\n1. Di layar setelan aplikasi yang terbuka, ketuk menu ⋮ di pojok kanan atas (atau gulir ke bawah).\n2. Pilih "Izinkan setelan yang dibatasi".\n3. Konfirmasi dengan sidik jari atau kata sandi dan kembali ke aplikasi.</string>
    <string name="restricted_dialog_open">Buka setelan aplikasi</string>

    <string name="forbidden_dialog_title">Setelan yang dilarang</string>
    <string name="forbidden_dialog_text">Untuk mengaktifkan layanan aksesibilitas, diperlukan izin sekali di setelan aplikasi:\n\n1. Di layar setelan aplikasi yang terbuka, ketuk menu ⋮ di pojok kanan atas (atau gulir ke bawah).\n2. Pilih "Izinkan setelan yang dilarang".\n3. Konfirmasi dengan sidik jari atau kata sandi dan kembali ke aplikasi.</string>
