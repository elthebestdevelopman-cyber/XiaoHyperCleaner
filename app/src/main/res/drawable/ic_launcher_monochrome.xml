<?xml version="1.0" encoding="utf-8"?>
<!-- Одноцветный силуэт для тематических иконок Android 13+.
     Система сама перекрасит его под цвет обоев. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="160"
    android:viewportHeight="160">

    <!-- Ушки -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,22 L36,0 L62,18 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M115,22 L124,0 L98,18 Z" />

    <!-- Голова -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,52 Q30,15 80,15 Q130,15 130,52 Q130,88 80,88 Q30,88 30,52 Z" />

    <!-- Тело -->
