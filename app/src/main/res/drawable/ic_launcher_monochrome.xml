         за счёт порядка отрисовки в тематической иконке) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M58,52 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <path
        android:fillColor="#00000000"
