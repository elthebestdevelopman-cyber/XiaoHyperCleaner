<?xml version="1.0" encoding="utf-8"?>
<!--
    Эталонный дизайн робокота (маскот XiaoHyperCleaner).

    ИСТОЧНИК ИСТИНЫ для всех версий робокота в проекте:
    - ic_launcher_foreground.xml (адаптивная иконка, scale 0.42)
    - ic_launcher_monochrome.xml (тематическая иконка, scale 0.42)
    - OverlayService (showAutomation, showResult — 120x120 dp)
    - OptimizationLevelDialog (с wobble-анимацией — 160x140 dp)
    - OnboardingScreen (страницы 1 и 3 — 160x160 dp)

    РАЗМЕР: 160x160 dp (viewport 1:1)

    ЦВЕТОВАЯ ПАЛИТРА (Material Design):
    - Blue Grey 200 (#B0BEC5) — основной металл (тело, голова)
    - Blue Grey 300 (#90A4AE) — тёмные детали (лапки, ушки, хвост)
    - Blue Grey 700 (#546E7A) — акцентные тёмные (грудная панель, винтики)
    - Light Blue 300 (#4FC3F7) — "живое" свечение (глаза, индикаторы)
    - Light Blue 50 (#E1F5FE) — яркие блики
    - Red A200 (#FF5252) — кончик антенны
    - Pink A100 (#FF80AB, α=0.8) — румянец
    - Blue Grey 900 (#263238) — экран-лицо

    ПОРЯДОК СЛОЁВ (важно для z-order):
    1. Хвостик-антенна (ЗА телом)
    2. Тело + грудная панель + индикатор
    3. Лапки с подушечками
    4. Голова
    5. Ушки (металл + свечение внутри)
    6. Антенна на голове (красный шарик)
    7. Экран-лицо + глаза + рот + румянец + винтики
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="160"
    android:viewportHeight="160">

    <!-- Хвостик-антенна (за телом) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M115,110 Q135,105 140,92"
        android:strokeWidth="3"
        android:strokeColor="#546E7A"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M140,92 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

    <!-- Тело (металлическое, округлое) -->
    <path
        android:fillColor="#B0BEC5"
        android:pathData="M42,98 Q42,85 55,83 L105,83 Q118,85 118,98 L118,135 Q118,148 105,148 L55,148 Q42,148 42,135 Z" />

    <!-- Тёмная грудная панель -->
    <path
        android:fillColor="#546E7A"
        android:pathData="M62,98 Q62,90 72,90 L88,90 Q98,90 98,98 L98,130 Q98,138 88,138 L72,138 Q62,138 62,130 Z" />

    <!-- Светящийся индикатор на груди -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M80,114 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path
        android:fillColor="#E1F5FE"
        android:pathData="M80,114 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />

    <!-- Левая лапка (группа — для анимации «умывания») -->
    <group
        android:name="left_paw_group"
        android:pivotX="55"
        android:pivotY="130">
        <path
            android:name="left_paw"
            android:fillColor="#90A4AE"
            android:pathData="M46,128 Q43,128 43,136 L43,148 Q43,153 49,153 L61,153 Q67,153 67,148 L67,136 Q67,128 61,128 Z" />
        <path
            android:fillColor="#4FC3F7"
            android:pathData="M51,146 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
        <path
            android:fillColor="#4FC3F7"
            android:pathData="M58,146 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    </group>
    <!-- Правая лапка -->
    <path
        android:fillColor="#90A4AE"
        android:pathData="M93,128 Q87,128 87,136 L87,148 Q87,153 93,153 L105,153 Q111,153 111,148 L111,136 Q111,128 105,128 Z" />
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M96,146 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M103,146 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />

    <!-- Голова (большая, металлическая, круглая) -->
    <path
        android:fillColor="#B0BEC5"
        android:pathData="M30,52 Q30,15 80,15 Q130,15 130,52 Q130,88 80,88 Q30,88 30,52 Z" />

    <!-- Левое кошачье ушко (металлическое) -->
    <path
        android:fillColor="#90A4AE"
        android:pathData="M45,22 L36,0 L62,18 Z" />
    <!-- Правое кошачье ушко -->
    <path
        android:fillColor="#90A4AE"
        android:pathData="M115,22 L124,0 L98,18 Z" />

    <!-- Светящаяся внутренняя часть ушек -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M47,20 L42,7 L57,17 Z" />
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M113,20 L118,7 L103,17 Z" />

    <!-- Антенна на голове -->
    <path
        android:name="antenna_tip"
        android:fillColor="@android:color/transparent"
        android:pathData="M80,15 L80,5"
        android:strokeWidth="2.5"
        android:strokeColor="#546E7A"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#FF5252"
        android:pathData="M80,5 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    <!-- Экран-лицо (тёмный, скруглённый) -->
    <path
        android:fillColor="#263238"
        android:pathData="M42,42 Q42,28 80,28 Q118,28 118,42 L118,66 Q118,78 80,78 Q42,78 42,66 Z" />

    <!-- Левый глаз (светящийся, круглый) -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M58,52 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <!-- Правый глаз -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M102,52 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />

    <!-- Внутренняя часть глаз (ярче) -->
    <path
        android:fillColor="#E1F5FE"
        android:pathData="M58,52 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
    <path
        android:fillColor="#E1F5FE"
        android:pathData="M102,52 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

    <!-- Блики в глазах -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60,49 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M104,49 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

    <!-- Милый ротик (светящаяся дуга на экране) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M72,64 Q80,70 88,64"
        android:strokeWidth="2"
        android:strokeColor="#4FC3F7"
        android:strokeLineCap="round" />

    <!-- Румянец-индикаторы на щеках -->
    <path
        android:fillAlpha="0.8"
        android:fillColor="#FF80AB"
        android:pathData="M48,62 m-3,0 a3,2.5 0 1,0 6,0 a3,2.5 0 1,0 -6,0" />
    <path
        android:fillAlpha="0.8"
        android:fillColor="#FF80AB"
        android:pathData="M112,62 m-3,0 a3,2.5 0 1,0 6,0 a3,2.5 0 1,0 -6,0" />

    <!-- Боковые винтики на голове -->
    <path
        android:fillColor="#546E7A"
        android:pathData="M36,52 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#546E7A"
        android:pathData="M124,52 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
</vector>