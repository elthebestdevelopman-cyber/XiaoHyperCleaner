<?xml version="1.0" encoding="utf-8"?><!--
    Передний план (foreground) адаптивной иконки приложения.

    ИСПОЛЬЗУЕТСЯ В:
    - mipmap-anydpi-v26/ic_launcher.xml (адаптивная иконка Android 8+)
    - mipmap-anydpi-v26/ic_launcher_round.xml (круглая версия)

    КОМПОЗИЦИЯ:
    - Робокот (масштаб 0.42) из ic_robot_companion.xml
    - Фирменная плашка "XHC" (оранжевая, с белыми буквами)

    SAFE ZONE (важно для адаптивных иконок):
    Контент должен быть в центральной области 72×72 dp
    (отступ 18 dp со всех сторон от края 108×108 dp).

    ИСПРАВЛЕНИЯ:
    1. 🔴 translateY увеличен с 12 до 18 — ушки теперь в safe zone
    2. 🟡 Плашка XHC сдвинута с y=72 на y=76 — больше отступ от низа
    3. ✅ Добавлена документация

    ЦВЕТОВАЯ СХЕМА:
    - Робокот: серо-голубой (Blue Grey + Light Blue)
    - Плашка: Deep Orange 400 (#FF7043) — гармонирует с Amber фоном
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Робокот (эталонный дизайн из ic_robot_companion.xml) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--
        ИСПРАВЛЕНО: translateY="18" (было 12)
        Теперь ушки робокота (y=18 в финальной позиции) находятся
        точно на верхней границе safe zone и не обрезаются на
        устройствах с круглой или squircle-маской иконки.

        Позиция после трансформации:
        - Левый край: 18dp (совпадает с safe zone)
        - Правый край: 18 + 67.2 = 85.2dp (в safe zone)
        - Верх: 18dp (в safe zone) ✅
        - Низ: 18 + 67.2 = 85.2dp (в safe zone) ✅
    -->
    <group
        android:scaleX="0.42"
        android:scaleY="0.42"
        android:translateX="18"
        android:translateY="18">

        <!-- Хвостик-антенна (за телом) -->
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M115,110 Q135,105 140,92"
            android:strokeWidth="3"
            android:strokeColor="#546E7A"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#4FC3F7"
            android:pathData="M140,92 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

        <!-- Тело (металлическое, округлое) -->
