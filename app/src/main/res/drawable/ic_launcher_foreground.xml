            android:pathData="M104,49 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

        <!-- Милый ротик (светящаяся дуга на экране) -->
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M72,64 Q80,70 88,64"
            android:strokeWidth="2"
            android:strokeColor="#4FC3F7"
            android:strokeLineCap="round" />

        <!-- Румянец-индикаторы на щеках -->
        <path
            android:fillAlpha="0.8"
            android:fillColor="#FF80AB"
            android:pathData="M48,62 m-3,0 a3,2.5 0 1,0 6,0 a3,2.5 0 1,0 -6,0" />
        <path
            android:fillAlpha="0.8"
            android:fillColor="#FF80AB"
            android:pathData="M112,62 m-3,0 a3,2.5 0 1,0 6,0 a3,2.5 0 1,0 -6,0" />

        <!-- Боковые винтики на голове -->
