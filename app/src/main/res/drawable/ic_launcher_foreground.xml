            android:fillColor="#546E7A"
            android:pathData="M36,52 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
        <path
            android:fillColor="#546E7A"
            android:pathData="M124,52 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
    </group>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Фирменная плашка XHC (брендинг) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--
        ИСПРАВЛЕНО: translateY="76" (было 72)
        Теперь плашка находится на 4dp выше, обеспечивая больший
        отступ от нижнего края safe zone (y=90).

        Позиция: от (30, 76) до (74, 90)
        Нижний край плашки: y=90 (точно на границе safe zone) ✅
    -->
    <group
        android:translateX="30"
        android:translateY="76">
        <!-- Фон плашки (Deep Orange 400) -->
        <path
            android:fillColor="#FF7043"
            android:pathData="M3,0 H41 A3,3 0 0 1 44,3 V11 A3,3 0 0 1 41,14 H3 A3,3 0 0 1 0,11 V3 A3,3 0 0 1 3,0 Z" />
        <!-- Буквы "XHC" (белые, нарисованные path'ами) -->
        <group
            android:translateX="7"
            android:translateY="2">
            <!-- X -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M0,0 L3,0 L4,3.2 L5,0 L8,0 L5.6,5 L8,10 L5,10 L4,6.8 L3,10 L0,10 L2.4,5 Z" />
            <!-- H -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M11,0 L14,0 L14,3.5 L16,3.5 L16,0 L19,0 L19,10 L16,10 L16,6.5 L14,6.5 L14,10 L11,10 Z" />
            <!-- C -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M22,0 L30,0 L30,3 L25,3 L25,7 L30,7 L30,10 L22,10 Z" />
        </group>
    </group>
</vector>