<?xml version="1.0" encoding="utf-8"?><!--
    Правила Auto Backup для Android 6.0-11 (API 23-30).
    Для Android 12+ (API 31+) используется data_extraction_rules.xml.

    ССЫЛКА В AndroidManifest.xml:
    android:fullBackupContent="@xml/backup_rules"

    ЧТО ИСКЛЮЧАЕМ И ПОЧЕМУ:
    1. DataStore (xhc_settings.preferences_pb) — содержит настройки пользователя,
       прогресс онбординга, флаг применённой оптимизации. После restore
       эти данные могут быть неактуальны (например, флаг "оптимизировано",
       хотя на новом устройстве оптимизация не выполнена).

    2. Логи (xhc.log, xhc.log.1, ...) — могут содержать чувствительные данные:
       имена пакетов, IP-адреса устройств, команды ADB.

    3. SharedPreferences — исключаем для обратной совместимости,
       если в будущем будут использоваться.

    ЧТО НЕ ИСКЛЮЧАЕМ (остаётся в бэкапе):
    - Кэш изображений (если есть)
    - Временные файлы
    - Другие данные приложения
-->
<full-backup-content>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- DataStore — основной источник настроек приложения -->
    <!-- Путь: /data/data/<package>/files/datastore/xhc_settings.preferences_pb -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <exclude
        domain="file"
        path="datastore/xhc_settings.preferences_pb" />

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Логи AppLog — содержат чувствительные данные -->
    <!-- Путь: /data/data/<package>/files/xhc.log (и ротированные версии) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <exclude
        domain="file"
        path="xhc.log" />
    <exclude
        domain="file"
        path="xhc.log.1" />
    <exclude
        domain="file"
        path="xhc.log.2" />

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SharedPreferences (обратная совместимость) -->
    <!-- Проект использует DataStore, но оставляем exclude на случай -->
    <!-- использования библиотек с SharedPreferences (например, Shizuku) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>